NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=kiku
# Only use this for local development without MongoDB.
ALLOW_IN_MEMORY=true

# Redis (required in production for shared cache + distributed rate limiting)
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=kiku
REDIS_CONNECT_TIMEOUT_MS=5000
REQUIRE_REDIS=false

# Background automation / BullMQ workers
AUTOMATION_ENABLED=true
REQUIRE_AUTOMATION=false
AUTOMATION_HEARTBEAT_TTL_MS=90000
AUTOMATION_LOCK_DURATION_MS=60000
AUTOMATION_ACTIVE_USER_DAYS=30
AUTOMATION_USER_BATCH_SIZE=500
COMPARISON_CACHE_TTL_MS=60000
COMPARISON_REFRESH_LEAD_MS=10000
COMPARISON_DEMAND_WINDOW_MS=1800000
COMPARISON_REQUEST_RETENTION_DAYS=7
REGION_FRESH_TTL_MS=900000
REGION_RETENTION_TTL_MS=86400000
REGION_ERROR_TTL_MS=60000
REGION_SCRAPE_TIMEOUT_MS=45000
REGION_RESPONSE_MAX_BYTES=8388608
# Kiku can start up to 10 independent pincode refreshes concurrently; validate this against your scraper before increasing it.
REGION_SCRAPE_CONCURRENCY=10
REGION_SCRAPE_QUEUE_MAX=50
PROVIDER_HEALTH_EVERY_MS=10800000
PROVIDER_HEALTH_TTL_MS=14400000
RECIPE_SYNC_EVERY_MS=43200000
RECIPE_SYNC_QUERIES=
INSIGHTS_ROLLUP_EVERY_MS=900000
RECOMMENDATION_ROLLUP_EVERY_MS=1800000
RECOMMENDATION_CACHE_TTL_MS=900000
MAINTENANCE_EVERY_MS=3600000

# Session/auth
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TTL_DAYS=30
GOOGLE_CLIENT_ID=

# Comparison service (the separate fixed Food-Price-Clash/Mise service)
COMPARE_SERVICE_URL=http://127.0.0.1:8000
COMPARE_TIMEOUT_MS=20000

# Recipes
RECIPE_PROVIDER_URL=https://www.themealdb.com/api/json/v1/1

# Kiku AI layer (optional; deterministic fallback always remains available)
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash
CLOUDFLARE_AI_TIMEOUT_MS=20000
CLOUDFLARE_AI_MAX_TOKENS=700

# Account email flows (optional unless REQUIRE_EMAIL_VERIFICATION=true)
EMAIL_WEBHOOK_URL=
PUBLIC_APP_URL=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=false

# Browser/API origin allowlist
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4000

RECIPE_ENRICHMENT_ENABLED=true
