# Public client configuration only. Never put server secrets here.
VITE_GOOGLE_CLIENT_ID=

# Keep the Vite dev server local-only by default.
VITE_DEV_HOST=127.0.0.1
MIDDLEWARE_URL=http://localhost:4000


# Regional discovery
# Serve one PIN-specific regional snapshot as fresh for 24 hours.
REGION_FRESH_TTL_MS=86400000
# Retain expired regional snapshots for up to 7 days for stale fallback/diagnostics.
REGION_RETENTION_TTL_MS=604800000
REGION_ERROR_TTL_MS=60000
REGION_EMPTY_TTL_MS=30000
REGION_SCRAPE_TIMEOUT_MS=45000
REGION_RESPONSE_MAX_BYTES=8388608
REGION_SCRAPE_CONCURRENCY=10
REGION_SCRAPE_QUEUE_MAX=50

# Optional external provider data source. Keep the key server-side; never use VITE_.
REALDATA_API_KEY=
REALDATA_API_BASE_URL=https://api.realdataapi.com
REALDATA_API_TIMEOUT_SECONDS=30
REALDATA_SWIGGY_SEARCH_PATH=/v1/swiggy/search
REALDATA_SWIGGY_MENU_PATH=/v1/swiggy/menu
REALDATA_ZOMATO_SEARCH_PATH=/v1/zomato/search
REALDATA_ZOMATO_MENU_PATH=/v1/zomato/menu
REALDATA_QUERY_PARAM=query
REALDATA_LOCATION_PARAM=city
REALDATA_URL_PARAM=url

# Thirdwatch / Apify server-side provider credentials. Keep out of VITE_* variables.
APIFY_API_BASE_URL=https://api.apify.com
APIFY_TIMEOUT_SECONDS=90
APIFY_RUN_TIMEOUT_SECONDS=90
APIFY_STATUS_WAIT_SECONDS=10
APIFY_RESPONSE_MAX_BYTES=8388608
APIFY_SWIGGY_ENABLED=true
APIFY_SWIGGY_TOKEN=
# Zomato provider intentionally disabled until a verified working Actor is selected.
APIFY_ZOMATO_ENABLED=false
APIFY_ZOMATO_TOKEN=
APIFY_SWIGGY_ACTOR=shahidirfan~swiggy-restaurant-scraper
APIFY_ZOMATO_ACTOR=thirdwatch~zomato-scraper
APIFY_SWIGGY_MAX_RESULTS=5
APIFY_SWIGGY_REGION_KEYWORDS=biryani,paneer,chicken,mutton,egg,ramen,thai,pizza,desserts,dal,noodles
APIFY_SWIGGY_REGION_MAX_PAGES=1
APIFY_SWIGGY_MENU_ACTOR=smacient~swiggy-restaurant-menu-extractor
APIFY_SWIGGY_MENU_MAX_RESTAURANTS=5
APIFY_SWIGGY_MENU_RUN_TIMEOUT_SECONDS=360
APIFY_ZOMATO_MAX_RESULTS=5
APIFY_MAX_CONCURRENT_RUNS=1
APIFY_ERROR_COOLDOWN_SECONDS=300
APIFY_FALLBACK_REALDATA=false

# PIN -> city/coordinates resolver for Apify targeting.
PIN_RESOLVER_POSTAL_BASE_URL=https://api.postalpincode.in
PIN_RESOLVER_GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
PIN_RESOLVER_TIMEOUT_SECONDS=10
PIN_RESOLVER_RESPONSE_MAX_BYTES=1048576
PIN_RESOLVER_CACHE_TTL_SECONDS=2592000
PIN_RESOLVER_CACHE_MAX_ITEMS=1024
PIN_RESOLVER_MIN_GEOCODE_INTERVAL_SECONDS=1.1
PIN_RESOLVER_USER_AGENT=Kiku/1.0 (local food discovery app)
PIN_RESOLVER_REFERER=http://localhost:5173/
